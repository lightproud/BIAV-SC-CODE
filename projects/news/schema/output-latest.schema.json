{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lightproud/BIAV-SC-CODE/projects/news/schema/output-latest.schema.json",
  "title": "Output layer contract — {source}-latest.json (v1)",
  "description": "采集管线运行期中间产物契约 v1（2026-07-02 P2-9 落档；2026-08-21 输出展示层整层删除后订正射程）。{source}-latest.json 由 split_output.py 产出**在运行期工作根**（archive_layout.news_run_root()，不进 git），同一轮内由 archive_platforms.py 消费落全量档案层；原「黑池与前端直读」消费面已随该层删除而消失。改动本契约仍须升 contract_version（消费方 = 同管线下游步骤）。已知口径差（刻意保留，勿归一）：中间态 source 保留原始名（如 steam 文件内 items 的 source='steam' 但 news.json 原始层可见 steam_review），数据归档层则按 sources.ARCHIVE_PLATFORM_FOLD 折叠。本层为过滤选样（data_layer='output'），任何分析一律走全量档案层。",
  "type": "object",
  "required": ["collected_at", "source", "data_layer", "item_count", "items"],
  "properties": {
    "contract_version": { "const": 1 },
    "collected_at": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "data_layer": { "const": "output" },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "time", "title", "engagement"],
        "properties": {
          "source": { "type": "string" },
          "time": { "type": "string" },
          "lang": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "url": { "type": "string" },
          "author": { "type": "string" },
          "engagement": { "type": "integer", "minimum": 0 },
          "media_url": { "type": "string" },
          "content_type": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
