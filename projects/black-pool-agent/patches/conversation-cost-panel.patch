diff --git a/apps/desktop/src/store/usage-ledger.test.ts b/apps/desktop/src/store/usage-ledger.test.ts
new file mode 100644
index 00000000..5c48482e
--- /dev/null
+++ b/apps/desktop/src/store/usage-ledger.test.ts
@@ -0,0 +1,192 @@
+import { beforeEach, describe, expect, it } from 'vitest'
+
+import {
+  $usageLedger,
+  dayKey,
+  formatCny,
+  recentDays,
+  recordSpend,
+  reloadUsageLedger,
+  resetUsageLedger,
+  RETAINED_DAYS_FOR_TEST,
+  startOfMonthKey,
+  startOfWeekKey,
+  STORAGE_KEY,
+  sumSince,
+  USD_TO_CNY
+} from './usage-ledger'
+
+const spend = (costUsd: number) => ({ costUsd, input: 10, output: 5 })
+
+// Local-time constructor on purpose: the ledger keys by local day, so a UTC
+// literal would silently test a different day than the code produces.
+const at = (year: number, month: number, day: number) => new Date(year, month - 1, day, 12)
+
+beforeEach(() => {
+  window.localStorage.clear()
+  resetUsageLedger()
+})
+
+describe('day keys', () => {
+  it('keys by local calendar day, not UTC', () => {
+    // 23:30 local on the 6th is already the 7th in UTC east of Greenwich.
+    expect(dayKey(new Date(2026, 7, 6, 23, 30))).toBe('2026-08-06')
+  })
+
+  it('zero-pads so keys sort lexically as dates', () => {
+    expect(dayKey(at(2026, 1, 9))).toBe('2026-01-09')
+    expect(dayKey(at(2026, 1, 9)) < dayKey(at(2026, 1, 10))).toBe(true)
+    expect(dayKey(at(2026, 9, 1)) < dayKey(at(2026, 10, 1))).toBe(true)
+  })
+})
+
+describe('week and month boundaries', () => {
+  it('starts the week on Monday', () => {
+    // 2026-08-06 is a Thursday.
+    expect(startOfWeekKey(at(2026, 8, 6))).toBe('2026-08-03')
+  })
+
+  it('treats Monday as its own week start', () => {
+    expect(startOfWeekKey(at(2026, 8, 3))).toBe('2026-08-03')
+  })
+
+  it('keeps Sunday in the week that began the previous Monday', () => {
+    // The trap: Date.getDay() calls Sunday 0, which would jump a week forward.
+    expect(startOfWeekKey(at(2026, 8, 9))).toBe('2026-08-03')
+  })
+
+  it('walks back across a month edge', () => {
+    // 2026-08-01 is a Saturday, so its week began in July.
+    expect(startOfWeekKey(at(2026, 8, 1))).toBe('2026-07-27')
+  })
+
+  it('starts the month on the first', () => {
+    expect(startOfMonthKey(at(2026, 8, 6))).toBe('2026-08-01')
+  })
+})
+
+describe('recording spend', () => {
+  it('accumulates repeated spend into one day bucket', () => {
+    recordSpend(spend(1), at(2026, 8, 6))
+    recordSpend(spend(2), at(2026, 8, 6))
+
+    const ledger = $usageLedger.get()
+
+    expect(Object.keys(ledger)).toEqual(['2026-08-06'])
+    expect(ledger['2026-08-06'].costUsd).toBe(3)
+    expect(ledger['2026-08-06'].input).toBe(20)
+  })
+
+  it('keeps separate days apart', () => {
+    recordSpend(spend(1), at(2026, 8, 5))
+    recordSpend(spend(2), at(2026, 8, 6))
+
+    expect(Object.keys($usageLedger.get()).sort()).toEqual(['2026-08-05', '2026-08-06'])
+  })
+
+  it('ignores empty deltas rather than banking a zero day', () => {
+    recordSpend({ costUsd: 0, input: 0, output: 0 }, at(2026, 8, 6))
+
+    expect($usageLedger.get()).toEqual({})
+  })
+
+  it('ignores negative and non-finite values instead of corrupting the total', () => {
+    recordSpend({ costUsd: Number.NaN, input: -5, output: 7 }, at(2026, 8, 6))
+
+    const day = $usageLedger.get()['2026-08-06']
+
+    expect(day.costUsd).toBe(0)
+    expect(day.input).toBe(0)
+    expect(day.output).toBe(7)
+  })
+
+  it('survives a restart by way of localStorage', () => {
+    recordSpend(spend(4), at(2026, 8, 6))
+    $usageLedger.set({})
+    reloadUsageLedger()
+
+    expect($usageLedger.get()['2026-08-06'].costUsd).toBe(4)
+  })
+})
+
+describe('totals', () => {
+  it('sums only days at or after the boundary', () => {
+    recordSpend(spend(1), at(2026, 8, 2))
+    recordSpend(spend(2), at(2026, 8, 3))
+    recordSpend(spend(4), at(2026, 8, 6))
+
+    // Week beginning Monday 2026-08-03 excludes the Sunday before it.
+    expect(sumSince($usageLedger.get(), '2026-08-03').costUsd).toBe(6)
+    expect(sumSince($usageLedger.get(), '2026-08-01').costUsd).toBe(7)
+  })
+
+  it('excludes last month from the month to date', () => {
+    recordSpend(spend(9), at(2026, 7, 31))
+    recordSpend(spend(1), at(2026, 8, 1))
+
+    expect(sumSince($usageLedger.get(), startOfMonthKey(at(2026, 8, 6))).costUsd).toBe(1)
+  })
+
+  it('returns zeroes for an empty ledger', () => {
+    expect(sumSince({}, '2026-08-01')).toEqual({ costUsd: 0, input: 0, output: 0 })
+  })
+})
+
+describe('history', () => {
+  it('lists most recent first and honours the limit', () => {
+    recordSpend(spend(1), at(2026, 8, 4))
+    recordSpend(spend(2), at(2026, 8, 5))
+    recordSpend(spend(3), at(2026, 8, 6))
+
+    expect(recentDays($usageLedger.get(), 2).map(day => day.date)).toEqual(['2026-08-06', '2026-08-05'])
+  })
+
+  it('prunes beyond the retention window, keeping the newest days', () => {
+    const overflow = 3
+    const start = new Date(2025, 0, 1)
+
+    for (let index = 0; index < RETAINED_DAYS_FOR_TEST + overflow; index += 1) {
+      const day = new Date(start)
+
+      day.setDate(day.getDate() + index)
+      recordSpend(spend(1), day)
+    }
+
+    const keys = Object.keys($usageLedger.get()).sort()
+    const newest = new Date(start)
+
+    newest.setDate(newest.getDate() + RETAINED_DAYS_FOR_TEST + overflow - 1)
+
+    expect(keys).toHaveLength(RETAINED_DAYS_FOR_TEST)
+    expect(keys[keys.length - 1]).toBe(dayKey(newest))
+    expect(keys[0]).toBe(dayKey(new Date(2025, 0, 1 + overflow)))
+  })
+})
+
+describe('resilience', () => {
+  it('reads a corrupt ledger as empty instead of throwing', () => {
+    window.localStorage.setItem(STORAGE_KEY, 'not json at all')
+    reloadUsageLedger()
+
+    expect($usageLedger.get()).toEqual({})
+  })
+
+  it('drops entries that are not dated buckets', () => {
+    window.localStorage.setItem(
+      STORAGE_KEY,
+      JSON.stringify({ '2026-08-06': { costUsd: 2, input: 1, output: 1 }, nonsense: { costUsd: 5 } })
+    )
+    reloadUsageLedger()
+
+    expect(Object.keys($usageLedger.get())).toEqual(['2026-08-06'])
+  })
+})
+
+describe('currency', () => {
+  it('converts at the ruled rate and always shows two decimals', () => {
+    expect(USD_TO_CNY).toBe(6.8)
+    expect(formatCny(1)).toBe('¥6.80')
+    expect(formatCny(0)).toBe('¥0.00')
+    expect(formatCny(2.5)).toBe('¥17.00')
+  })
+})
