new file mode 100644
index 00000000..f8216c99
--- /dev/null
+++ b/apps/desktop/src/store/usage-ledger.ts
@@ -0,0 +1,208 @@
+import { atom } from 'nanostores'
+
+/**
+ * Persistent daily spend ledger behind the week / month / history views.
+ *
+ * The per-round ledger in `usage-rounds` lives in memory and dies with the
+ * app; "this week" and "this month" have to outlive restarts, so this store
+ * keeps one bucket per calendar day in localStorage and never holds raw
+ * per-round rows. Buckets are keyed by *local* date: the keeper reads these
+ * numbers as Beijing days, and a UTC key would roll the day over at 08:00.
+ *
+ * Feeding happens in `usage-rounds.recordCumulativeUsage`, which already
+ * turns the gateway's cumulative snapshots into per-round deltas and
+ * deliberately skips the first snapshot of a resumed session. That skip is
+ * what keeps this ledger honest across restarts: a resumed session reports
+ * usage that earlier runs already banked, and counting it again would
+ * inflate every total.
+ */
+export interface LedgerDay {
+  costUsd: number
+  date: string
+  input: number
+  output: number
+}
+
+export interface LedgerTotals {
+  costUsd: number
+  input: number
+  output: number
+}
+
+/**
+ * USD -> CNY for display only (keeper's ruling, 2026-08-05: "estimate at 6.8").
+ * Upstream prices every model in USD; nothing downstream reads this back, so a
+ * fixed rate is a labelling choice rather than an accounting one. The panel
+ * says so next to the numbers — an unlabelled ¥ would read as settled fact.
+ */
+export const USD_TO_CNY = 6.8
+
+export const STORAGE_KEY = 'black-pool:usage-ledger'
+
+/** ~13 months: long enough to compare a month against last year's, bounded enough to stay small. */
+const RETAINED_DAYS = 400
+
+const pad = (value: number): string => String(value).padStart(2, '0')
+
+/** Local calendar day, not UTC — see the store comment. */
+export function dayKey(at: Date): string {
+  return `${at.getFullYear()}-${pad(at.getMonth() + 1)}-${pad(at.getDate())}`
+}
+
+/** Monday-start week, matching how the keeper reads a work week. */
+export function startOfWeekKey(at: Date): string {
+  const start = new Date(at.getFullYear(), at.getMonth(), at.getDate())
+  const weekday = (start.getDay() + 6) % 7
+
+  start.setDate(start.getDate() - weekday)
+
+  return dayKey(start)
+}
+
+export function startOfMonthKey(at: Date): string {
+  return `${at.getFullYear()}-${pad(at.getMonth() + 1)}-01`
+}
+
+const num = (value: unknown): number => (typeof value === 'number' && Number.isFinite(value) && value > 0 ? value : 0)
+
+function parseLedger(raw: null | string): Record<string, LedgerDay> {
+  if (!raw) {
+    return {}
+  }
+
+  try {
+    const parsed: unknown = JSON.parse(raw)
+
+    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+      return {}
+    }
+
+    const out: Record<string, LedgerDay> = {}
+
+    for (const [date, value] of Object.entries(parsed as Record<string, unknown>)) {
+      if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !value || typeof value !== 'object') {
+        continue
+      }
+
+      const day = value as Partial<LedgerDay>
+
+      out[date] = {
+        costUsd: num(day.costUsd),
+        date,
+        input: num(day.input),
+        output: num(day.output)
+      }
+    }
+
+    return out
+  } catch {
+    // A corrupt ledger is a display problem, never a reason to break the app.
+    return {}
+  }
+}
+
+function readStored(): Record<string, LedgerDay> {
+  if (typeof window === 'undefined') {
+    return {}
+  }
+
+  try {
+    return parseLedger(window.localStorage.getItem(STORAGE_KEY))
+  } catch {
+    return {}
+  }
+}
+
+function prune(ledger: Record<string, LedgerDay>): Record<string, LedgerDay> {
+  const keys = Object.keys(ledger).sort()
+
+  if (keys.length <= RETAINED_DAYS) {
+    return ledger
+  }
+
+  const kept: Record<string, LedgerDay> = {}
+
+  for (const key of keys.slice(-RETAINED_DAYS)) {
+    kept[key] = ledger[key]
+  }
+
+  return kept
+}
+
+export const $usageLedger = atom<Record<string, LedgerDay>>(readStored())
+
+function persist(ledger: Record<string, LedgerDay>): void {
+  $usageLedger.set(ledger)
+
+  if (typeof window === 'undefined') {
+    return
+  }
+
+  try {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(ledger))
+  } catch {
+    // Quota or a locked-down profile: the in-memory atom still drives this session.
+  }
+}
+
+export function recordSpend(delta: Pick<LedgerDay, 'costUsd' | 'input' | 'output'>, at: Date = new Date()): void {
+  const costUsd = num(delta.costUsd)
+  const input = num(delta.input)
+  const output = num(delta.output)
+
+  if (costUsd === 0 && input === 0 && output === 0) {
+    return
+  }
+
+  const date = dayKey(at)
+  const ledger = { ...$usageLedger.get() }
+  const existing = ledger[date]
+
+  ledger[date] = {
+    costUsd: (existing?.costUsd ?? 0) + costUsd,
+    date,
+    input: (existing?.input ?? 0) + input,
+    output: (existing?.output ?? 0) + output
+  }
+
+  persist(prune(ledger))
+}
+
+/** Inclusive lower bound; keys are ISO-ish so lexical order is date order. */
+export function sumSince(ledger: Record<string, LedgerDay>, fromKey: string): LedgerTotals {
+  const totals: LedgerTotals = { costUsd: 0, input: 0, output: 0 }
+
+  for (const day of Object.values(ledger)) {
+    if (day.date >= fromKey) {
+      totals.costUsd += day.costUsd
+      totals.input += day.input
+      totals.output += day.output
+    }
+  }
+
+  return totals
+}
+
+/** Most recent first, days with no spend omitted. */
+export function recentDays(ledger: Record<string, LedgerDay>, limit: number): LedgerDay[] {
+  return Object.values(ledger)
+    .sort((a, b) => (a.date < b.date ? 1 : -1))
+    .slice(0, limit)
+}
+
+export function formatCny(costUsd: number): string {
+  return `¥${(costUsd * USD_TO_CNY).toFixed(2)}`
+}
+
+/** Test seam: drop everything, in memory and on disk. */
+export function resetUsageLedger(): void {
+  persist({})
+}
+
+/** Re-read from disk — the seam a second window would need, and what the tests drive. */
+export function reloadUsageLedger(): void {
+  $usageLedger.set(readStored())
+}
+
+/** Retention is an implementation detail everywhere except the test that guards it. */
+export const RETAINED_DAYS_FOR_TEST = RETAINED_DAYS
