diff --git a/apps/desktop/src/lib/lag-trace.ts b/apps/desktop/src/lib/lag-trace.ts
new file mode 100644
index 0000000..9601e09
--- /dev/null
+++ b/apps/desktop/src/lib/lag-trace.ts
@@ -0,0 +1,92 @@
+// Renderer-side interaction latency tracing.
+//
+// "Every interaction waits several seconds" is a symptom three different
+// layers can produce, and from the outside they look identical:
+//
+//   1. the renderer's main thread is blocked (paint/layout/JS storm, or a
+//      GPU-less software rasterizer doing the compositing on the CPU),
+//   2. the gateway round-trip is slow (transport, event loop, or a handler
+//      holding the socket's read loop),
+//   3. the machine itself is slow (AV scanning, network share, swap).
+//
+// Nothing in the shipped app measured any of them, so a field report could
+// only be answered with guesses. This module measures the first two from
+// inside the renderer and writes them where they can be read back off the
+// user's machine afterwards.
+//
+// Output goes through `console.error` on purpose: the main process forwards
+// only level-3 renderer console messages into `logs/desktop.log`, and a trace
+// nobody can retrieve is not a trace. Everything here is rate-limited, and no
+// line is emitted at all while things are fast, so a healthy install stays
+// silent.
+
+/** Round-trip slower than this is worth a line (ms). */
+const SLOW_RPC_MS = 1_500
+/** Heartbeat drift past this means the main thread was blocked (ms). */
+const BLOCKED_MAIN_THREAD_MS = 1_000
+/** Heartbeat period (ms). */
+const HEARTBEAT_MS = 1_000
+/** Ceiling so a pathological install cannot flood the desktop log. */
+const MAX_LINES_PER_MINUTE = 30
+
+let windowStartedAt = 0
+let linesThisWindow = 0
+
+function emit(line: string): void {
+  const now = Date.now()
+
+  if (now - windowStartedAt > 60_000) {
+    windowStartedAt = now
+    linesThisWindow = 0
+  }
+
+  if (linesThisWindow >= MAX_LINES_PER_MINUTE) {
+    return
+  }
+
+  linesThisWindow += 1
+  console.error(line)
+}
+
+/**
+ * Record one gateway round-trip. `startedAt` is a `performance.now()` stamp
+ * taken immediately before the request went out.
+ */
+export function noteGatewayRoundTrip(method: string, startedAt: number, outcome: string = 'ok'): void {
+  const ms = Math.round(performance.now() - startedAt)
+
+  if (ms < SLOW_RPC_MS) {
+    return
+  }
+
+  emit(`[lag] gateway rpc method=${method} ms=${ms} outcome=${outcome}`)
+}
+
+/**
+ * Watch the renderer's main thread with a plain interval. A timer that should
+ * fire every second but fires late by more than a second means the main thread
+ * was busy for that long — which is exactly what "the UI froze" is.
+ *
+ * Hidden windows are throttled by Chromium by design, so drift is only
+ * reported while the window is actually visible.
+ */
+function installMainThreadWatch(): void {
+  if (typeof window === 'undefined') {
+    return
+  }
+
+  let last = performance.now()
+
+  window.setInterval(() => {
+    const now = performance.now()
+    const drift = now - last - HEARTBEAT_MS
+
+    last = now
+
+    if (drift >= BLOCKED_MAIN_THREAD_MS && document.visibilityState === 'visible') {
+      emit(`[lag] renderer main thread blocked ms=${Math.round(drift)}`)
+    }
+  }, HEARTBEAT_MS)
+}
+
+installMainThreadWatch()
