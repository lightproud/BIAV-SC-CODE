+# ── Per-RPC latency tracing ──────────────────────────────────────────
+# "Every interaction stalls for seconds" is reported from packaged desktops
+# far more often than it can be reproduced, and nothing in the gateway used
+# to record how long a handler actually took: the logs show what was called,
+# never how long it ran. Without that number the stall cannot be attributed
+# to a layer (renderer paint / transport / handler work) and the triage
+# degenerates into guessing.
+#
+# So every dispatched RPC is timed and anything past the threshold is logged
+# with its lane. The lane matters as much as the duration:
+#   * inline — ws.handle_ws awaits dispatch() before it reads the next frame,
+#     so an inline overrun is head-of-line blocking: every later request on
+#     that socket waits behind it. One slow inline handler is enough to make
+#     the whole UI feel frozen.
+#   * pool — the handler runs on _pool. Its own runtime delays only itself,
+#     but `queue_ms` (how long the job waited for a free worker) exposes pool
+#     saturation, which does delay everything routed to the pool.
+# Threshold in milliseconds; HERMES_RPC_SLOW_MS=0 disables the tracing.
+try:
+    _rpc_slow_ms = float(os.environ.get("HERMES_RPC_SLOW_MS") or "800")
+except (ValueError, TypeError):
+    _rpc_slow_ms = 800.0
+_RPC_SLOW_MS = max(0.0, _rpc_slow_ms)
+
+
+def _note_rpc_duration(method: str, lane: str, started: float, queued_ms: float = 0.0) -> None:
+    """Log one RPC's wall time when it crosses the slow threshold.
+
+    Never raises: tracing must not be able to fail a request.
+    """
+    if _RPC_SLOW_MS <= 0:
+        return
+    try:
+        elapsed_ms = (time.monotonic() - started) * 1000.0
+        if elapsed_ms < _RPC_SLOW_MS and queued_ms < _RPC_SLOW_MS:
+            return
+        logger.warning(
+            "slow rpc method=%s lane=%s ms=%.0f queue_ms=%.0f%s",
+            method,
+            lane,
+            elapsed_ms,
+            queued_ms,
+            " (inline: the ws read loop was blocked for this long)"
+            if lane == "inline"
+            else "",
+        )
+    except Exception:  # pragma: no cover - diagnostics are never fatal
+        pass
+
 # Reserve real stdout for JSON-RPC only; redirect Python's stdout to stderr
 # so stray print() from libraries/tools becomes harmless gateway.stderr instead
@@ -1919,14 +1968,23 @@ def dispatch(req: dict, transport: Optional[Transport] = None) -> dict | None:
         _rid, method, _params = normalized
