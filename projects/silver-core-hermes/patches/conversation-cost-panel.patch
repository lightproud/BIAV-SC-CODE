diff --git a/apps/desktop/src/app/shell/cost-usage-panel.tsx b/apps/desktop/src/app/shell/cost-usage-panel.tsx
new file mode 100644
index 000000000..d67fa5956
--- /dev/null
+++ b/apps/desktop/src/app/shell/cost-usage-panel.tsx
@@ -0,0 +1,97 @@
+import { useStore } from '@nanostores/react'
+import { useMemo } from 'react'
+
+import { useI18n } from '@/i18n'
+import { compactNumber } from '@/lib/format'
+import { $usageRounds } from '@/store/usage-rounds'
+import type { UsageStats } from '@/types/hermes'
+
+interface CostUsagePanelProps {
+  currentUsage: UsageStats
+  sessionId: string | null
+}
+
+function formatCost(cost: number, unknownLabel: string): string {
+  if (!(cost > 0)) {
+    return unknownLabel
+  }
+
+  return cost >= 0.995 ? `$${cost.toFixed(2)}` : `$${cost.toFixed(4)}`
+}
+
+function hitRate(cacheRead: number, input: number): null | string {
+  const denominator = cacheRead + input
+
+  if (denominator <= 0) {
+    return null
+  }
+
+  return `${Math.round((cacheRead / denominator) * 100)}%`
+}
+
+export function CostUsagePanel({ currentUsage, sessionId }: CostUsagePanelProps) {
+  const { t } = useI18n()
+  const copy = t.shell.statusbar.costUsagePanel
+  const roundsMap = useStore($usageRounds)
+
+  const rounds = useMemo(
+    () => (sessionId ? (roundsMap[sessionId] ?? []) : []),
+    [roundsMap, sessionId]
+  )
+
+  const cacheRead = currentUsage.cache_read ?? 0
+  const cacheWrite = currentUsage.cache_write ?? 0
+  const totalRate = hitRate(cacheRead, currentUsage.input)
+
+  const stats: Array<{ label: string; value: string }> = [
+    { label: copy.totalCost, value: formatCost(currentUsage.cost_usd ?? 0, copy.costUnknown) },
+    { label: copy.input, value: compactNumber(currentUsage.input) },
+    { label: copy.output, value: compactNumber(currentUsage.output) },
+    { label: copy.cacheRead, value: compactNumber(cacheRead) },
+    { label: copy.cacheWrite, value: compactNumber(cacheWrite) },
+    { label: copy.cacheHitRate, value: totalRate ?? copy.costUnknown }
+  ]
+
+  return (
+    <div className="w-72 p-3 text-xs">
+      <div className="mb-2 font-medium">{copy.title}</div>
+      <div className="mb-3 grid grid-cols-2 gap-x-3 gap-y-1">
+        {stats.map(item => (
+          <div className="flex items-baseline justify-between gap-2" key={item.label}>
+            <span className="text-(--ui-text-secondary)">{item.label}</span>
+            <span className="tabular-nums">{item.value}</span>
+          </div>
+        ))}
+      </div>
+      <div className="mb-1 font-medium">{copy.perRound}</div>
+      {rounds.length === 0 ? (
+        <div className="text-(--ui-text-secondary)">{copy.empty}</div>
+      ) : (
+        <div className="max-h-48 overflow-y-auto">
+          <table className="w-full text-left tabular-nums">
+            <thead>
+              <tr className="text-(--ui-text-secondary)">
+                <th className="pr-2 font-normal">{copy.round}</th>
+                <th className="pr-2 font-normal">{copy.input}</th>
+                <th className="pr-2 font-normal">{copy.output}</th>
+                <th className="pr-2 font-normal">{copy.cacheRead}</th>
+                <th className="font-normal">{copy.totalCost}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {[...rounds].reverse().map(round => (
+                <tr key={round.turn}>
+                  <td className="pr-2">{round.turn}</td>
+                  <td className="pr-2">{compactNumber(round.input)}</td>
+                  <td className="pr-2">{compactNumber(round.output)}</td>
+                  <td className="pr-2">{compactNumber(round.cacheRead)}</td>
+                  <td>{formatCost(round.costUsd, '—')}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+    </div>
+  )
+}
