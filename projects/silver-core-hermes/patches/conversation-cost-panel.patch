diff --git a/apps/desktop/src/store/usage-rounds.ts b/apps/desktop/src/store/usage-rounds.ts
new file mode 100644
index 000000000..1dd34c4df
--- /dev/null
+++ b/apps/desktop/src/store/usage-rounds.ts
@@ -0,0 +1,74 @@
+import { atom } from 'nanostores'
+
+import type { UsageStats } from '@/types/hermes'
+
+/**
+ * Per-round usage ledger for the conversation cost panel.
+ *
+ * The gateway reports *cumulative* session usage on each turn-final event.
+ * This store keeps the last cumulative snapshot per session and turns each
+ * new snapshot into a per-round delta. The first snapshot seen for a session
+ * (fresh app start or resume) only establishes the baseline — no phantom
+ * round is emitted for history accumulated before we were watching.
+ * Rounds live in memory only; an app restart starts a fresh ledger.
+ */
+export interface UsageRound {
+  at: number
+  cacheRead: number
+  cacheWrite: number
+  costUsd: number
+  input: number
+  output: number
+  turn: number
+}
+
+const MAX_ROUNDS_PER_SESSION = 500
+
+export const $usageRounds = atom<Record<string, UsageRound[]>>({})
+
+const lastCumulative: Record<string, UsageStats> = {}
+
+const num = (value: unknown): number => (typeof value === 'number' && Number.isFinite(value) ? value : 0)
+
+export function recordCumulativeUsage(sessionId: string, usage: Partial<UsageStats>): void {
+  if (!sessionId) {
+    return
+  }
+
+  const next: UsageStats = {
+    cache_read: num(usage.cache_read),
+    cache_write: num(usage.cache_write),
+    calls: num(usage.calls),
+    cost_usd: num(usage.cost_usd),
+    input: num(usage.input),
+    output: num(usage.output),
+    total: num(usage.total)
+  }
+
+  const prev = lastCumulative[sessionId]
+  lastCumulative[sessionId] = next
+
+  if (!prev) {
+    return
+  }
+
+  const delta: UsageRound = {
+    at: Date.now(),
+    cacheRead: Math.max(0, num(next.cache_read) - num(prev.cache_read)),
+    cacheWrite: Math.max(0, num(next.cache_write) - num(prev.cache_write)),
+    costUsd: Math.max(0, num(next.cost_usd) - num(prev.cost_usd)),
+    input: Math.max(0, next.input - prev.input),
+    output: Math.max(0, next.output - prev.output),
+    turn: 0
+  }
+
+  if (delta.input === 0 && delta.output === 0 && delta.cacheRead === 0 && delta.costUsd === 0) {
+    return
+  }
+
+  const map = $usageRounds.get()
+  const existing = map[sessionId] ?? []
+  delta.turn = (existing[existing.length - 1]?.turn ?? 0) + 1
+  const rounds = [...existing, delta].slice(-MAX_ROUNDS_PER_SESSION)
+  $usageRounds.set({ ...map, [sessionId]: rounds })
+}
